# accelo-mcp configuration
# Copy this file to .env and fill in your values.
# Never commit this file after adding real credentials.

# Required: Your Accelo deployment hostname prefix
# e.g. if your Accelo URL is https://mycompany.accelo.com, use "mycompany"
ACCELO_DEPLOYMENT=your-deployment

# Required: OAuth2 application credentials (from Configuration → API → Register Application)
ACCELO_CLIENT_ID=your-client-id
ACCELO_CLIENT_SECRET=your-client-secret

# Optional: Authentication type (default: web)
# All types use OAuth 2.0. They differ in whether a person authorises in a
# browser and whether a client secret is needed:
# - web:       Authorisation Code + refresh token. One-time browser login. Secret required.
# - public:    Authorisation Code with PKCE. One-time browser login. NO secret required,
#              but the user must still authorise in the browser (OAuth is not skipped).
#              ACCELO_REDIRECT_URI is required and must match the Accelo application.
# - installed: Authorisation Code via PIN. Approve in browser, then enter a PIN. Secret required.
# - service:   Client Credentials. No browser, no user login. Secret required.
ACCELO_AUTH_TYPE=service

# Optional: OAuth2 scope (default: read(all))
# Examples: read(all), write(all), read(companies,contacts),write(issues)
ACCELO_SCOPE=read(all)

# Required if ACCELO_AUTH_TYPE=web: Redirect URI registered with your application
# ACCELO_REDIRECT_URI=http://localhost:8080/oauth/callback

# Optional: HTTP transport settings (used only with --http or --sse)
# NOTE: the HTTP transport has NO inbound authentication and serves every caller
# with the one shared Accelo identity. It is single-user: if you bind beyond
# loopback, YOU must restrict access to the single intended client. See SECURITY.md.
# NOTE: ACCELO_MCP_PATH / ACCELO_MCP_JSON_RESPONSE / ACCELO_MCP_STATELESS apply
# to --http only and have no effect under --sse.
# NOTE: the boolean variables below accept 1/true/yes/on or 0/false/no/off
# (case-insensitive). To use a default, leave the line unset (not blank) — a
# present-but-blank value is rejected at startup.
# Interface to bind: 127.0.0.1 (default) keeps it local-only. Only set 0.0.0.0
# inside a container, and publish the port to loopback on the host
# (docker run -p 127.0.0.1:3000:3000 ...), never to all interfaces.
# ACCELO_MCP_HOST=127.0.0.1
# TCP port (default 3000)
ACCELO_MCP_PORT=3000
# Streamable HTTP endpoint path (default /mcp; --http only, ignored by --sse).
# Must start with '/'; a value without a leading slash is rejected at startup.
# ACCELO_MCP_PATH=/mcp
# Return a single JSON response instead of an SSE stream (default false;
# --http only, ignored by --sse)
# ACCELO_MCP_JSON_RESPONSE=false
# Run without transport-level MCP protocol session state (stream resumption).
# Protocol option only; does NOT add per-user credentials or make the server
# multi-user (default false; --http only, ignored by --sse)
# ACCELO_MCP_STATELESS=false
# Comma-separated Host/Origin allow-lists for DNS-rebinding protection.
# Required when the server is reached through a hostname other than localhost
# (e.g. behind a reverse proxy or load balancer). Host matching is exact unless
# an entry ends in ':*', and clients send the port, so use the 'host:*' form.
# ACCELO_MCP_ALLOWED_HOSTS=mcp.internal.example:*,127.0.0.1:*,localhost:*
# ACCELO_MCP_ALLOWED_ORIGINS=https://mcp.internal.example
# Disable the Host/Origin check entirely (prefer the allow-lists above)
# ACCELO_MCP_DISABLE_DNS_REBINDING_PROTECTION=false
# Acknowledge the HTTP transport has no inbound auth. Required to start on a
# non-loopback bind (e.g. 0.0.0.0). The server refuses to start on a non-loopback
# host unless this is set, to prevent accidental exposure. On a non-loopback bind
# it ALSO requires a Host allow-list above (ACCELO_MCP_ALLOWED_HOSTS; an Origin
# allow-list alone does not close the DNS-rebinding gap) — or an explicit
# ACCELO_MCP_DISABLE_DNS_REBINDING_PROTECTION=true — otherwise it refuses. See SECURITY.md.
# ACCELO_MCP_ALLOW_UNAUTHENTICATED=false
